[Unit]
Description=Pathos model runtime (%i)
After=network-online.target eidos-gpu.service
Wants=network-online.target eidos-gpu.service
RequiresMountsFor=/srv/eidos-data

[Service]
Type=simple
User=ollama
Group=ollama
Environment=OLLAMA_MODELS=/srv/eidos-data/eidos/models
Environment=OLLAMA_NO_CLOUD=1
Environment=OLLAMA_VULKAN=false
Environment=OLLAMA_LLM_LIBRARY=cuda_v12
Environment=OLLAMA_NUM_PARALLEL=1
Environment=OLLAMA_MAX_LOADED_MODELS=1
Environment=OLLAMA_CONTEXT_LENGTH=8192
Environment=OLLAMA_KEEP_ALIVE=-1
EnvironmentFile=/etc/eidos/ollama-%i.env
ExecStart=/usr/local/bin/ollama serve
ExecStartPost=/usr/bin/python3 /srv/eidos/infra/dell-t630/warm_model.py
TimeoutStartSec=360
Restart=on-failure
RestartSec=10
TimeoutStopSec=60
UMask=0027
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/srv/eidos-data/eidos/models /usr/share/ollama

[Install]
WantedBy=multi-user.target
