# Eidos Agent Configuration
EIDOS_SUBCONSCIOUS_NODE_BASE_URL=http://localhost:8000

# Subconscious Node Process Configuration (Overrides subconscious_node/config.json if set)
# These are read by the subconscious_node/utils.py if it's run as a separate process.
SUBPROCESS_LLAMA_CPP_SERVER_URL=http://localhost:8081/v1/chat/completions
SUBPROCESS_WILDCARD_RELATIVE_PATH=../wildcards/


# --- The rest of the original .env.example from the project ---
# .env.example file for Eidos AI Agent (Digital Being Simulation)

# -----------------------------------------------------------------------------
# LLM Configurations (Served via VLLM or other OpenAI-compatible API)
# -----------------------------------------------------------------------------

# Pathos (Main Conversational & "Self" LLM - Qwen2.5 32B VL) - REQUIRED
LLM_PATHOS_URL=http://your_vllm_server_ip:8000/v1
LLM_PATHOS_MODEL=Qwen/Qwen2.5-32B-Chat # Or your specific VLLM model ID for Qwen2.5 32B VL
LLM_PATHOS_API_KEY=vllm # Or 'none', 'lm-studio', 'ollama' depending on VLLM setup or if proxying
LLM_PATHOS_TEMP=0.6 # Adjusted for more creative/natural conversation
LLM_PATHOS_TIMEOUT=10.0 # Reduced for faster startup - increase if model needs more time
LLM_PATHOS_MAX_TOKENS=8192 # Qwen2.5 32B can handle larger contexts
LLM_PATHOS_MAX_TOOL_ITERATIONS=3 # For internal tools Pathos might use for self-planning
LLM_PATHOS_SUPPORTS_VISION=True # Qwen2.5 VL is multimodal
LLM_PATHOS_TIKTOKEN_NAME=cl100k_base # Or a more specific one if known for Qwen

# Logos Techne (Utility LLM: Summarization, Reflection, Initial Planning, etc.) - REQUIRED
# Can be a smaller, efficient model like Mistral 7B, Phi-2, etc.
LLM_LOGOS_TECHNE_URL=http://your_utility_vllm_server_ip:8001/v1
LLM_LOGOS_TECHNE_MODEL=mistralai/Mistral-7B-Instruct-v0.2 # Example
LLM_LOGOS_TECHNE_API_KEY=vllm
LLM_LOGOS_TECHNE_TEMP=0.3
LLM_LOGOS_TECHNE_TIMEOUT=10.0 # Reduced for faster startup - increase if model needs more time
LLM_LOGOS_TECHNE_MAX_TOKENS=4096
LLM_LOGOS_TECHNE_TIKTOKEN_NAME=cl100k_base

# Logos Deep Research (LLM for in-depth research synthesis) - REQUIRED if perform_deep_research is used by Pathos
# Can be same as LOGOS_TECHNE or a model better at synthesis.
LLM_LOGOS_RESEARCH_URL=http://your_utility_vllm_server_ip:8001/v1
LLM_LOGOS_RESEARCH_MODEL=mistralai/Mistral-7B-Instruct-v0.2 # Example
LLM_LOGOS_RESEARCH_API_KEY=vllm
LLM_LOGOS_RESEARCH_TEMP=0.5
LLM_LOGOS_RESEARCH_TIMEOUT=10.0 # Reduced for faster startup - increase if model needs more time
LLM_LOGOS_RESEARCH_MAX_TOKENS=4096
LLM_LOGOS_RESEARCH_TIKTOKEN_NAME=cl100k_base

# NPC LLM (For dialogues in Firmament simulations) - REQUIRED for NPC interactions
# Can be a smaller, characterful model.
LLM_NPC_URL=http://your_utility_vllm_server_ip:8002/v1 # Potentially a different port/server
LLM_NPC_MODEL=NousResearch/Hermes-2-Pro-Mistral-7B # Example known for roleplay
LLM_NPC_API_KEY=vllm
LLM_NPC_TEMP=0.75
LLM_NPC_TIMEOUT=10.0 # Reduced for faster startup - increase if model needs more time
LLM_NPC_MAX_TOKENS=1024
LLM_NPC_TIKTOKEN_NAME=cl100k_base

# Firmament Primary LLM (For Firmament's general purpose tasks like thought elaboration) - REQUIRED for Firmament
# Needs to be efficient and good at short narrative/descriptive generation.
LLM_FIRMAMENT_PRIMARY_URL=http://your_utility_vllm_server_ip:8003/v1 # Example, potentially a different port/server
LLM_FIRMAMENT_PRIMARY_MODEL=microsoft/Phi-3-mini-4k-instruct # Example: Small and capable
LLM_FIRMAMENT_PRIMARY_API_KEY=vllm # or ollama, lm-studio, none, etc.
LLM_FIRMAMENT_PRIMARY_TEMP=0.6
LLM_FIRMAMENT_PRIMARY_TIMEOUT=15.0
LLM_FIRMAMENT_PRIMARY_MAX_TOKENS=1536
#LLM_FIRMAMENT_PRIMARY_TOP_P=0.9
#LLM_FIRMAMENT_PRIMARY_PRESENCE_PENALTY=0.1
#LLM_FIRMAMENT_PRIMARY_FREQUENCY_PENALTY=0.1
LLM_FIRMAMENT_PRIMARY_TIKTOKEN_NAME=cl100k_base

# --- DEPRECATED LLM Roles (Kept for reference, but functionality shifted) ---
# LLM_CORE_ORCHESTRATOR_URL=... (Pathos LLM now handles this)
# LLM_LOGOS_VISION_URL=... (Pathos LLM is multimodal)

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
ENABLE_VISION_PROCESSING=True # Pathos LLM handles vision
ENABLE_DAILY_CONTEXT=True     # For Pathos's internal awareness
ENABLE_ONEIROS=True           # Dreams
ENABLE_PROACTIVE_BEHAVIOR=True # Pathos initiating conversation
ENABLE_MOOD_SIMULATION=True
ENABLE_MANAGED_FORGETTING=True
ENABLE_LEARNING_FROM_FEEDBACK=True # Pathos reflects on feedback
ENABLE_CURIOUSITY=True
ENABLE_WEB_SEARCH=True # Pathos uses his "computer" for this
ENABLE_KNOWLEDGE_UPKEEP=True # Pathos reflects on world facts
ENABLE_AUTONOMOUS_CURIOSITY_RESEARCH=True # Pathos can research things he's curious about

# --- DEFERRED / MOVED TO OTHER PROJECTS ---
# ENABLE_AISTHESIS=False
# ENABLE_AMBIENT_AUDIO=False
# ENABLE_WOLFRAM_ALPHA=True # Pathos might use this via his "computer"
# NEWS_API_ENABLED=True # Pathos might read news via his "computer"

# -----------------------------------------------------------------------------
# Ethos Core Configuration (Pathos's Memory, Self, Learning) - REQUIRED
# -----------------------------------------------------------------------------
ETHOS_MEMORY_DB_PATH=./eidos_memories/memory.sqlite
ETHOS_EMBEDDING_MODEL=all-MiniLM-L6-v2
ETHOS_EMBEDDING_MAX_TEXT_LENGTH=2560
ETHOS_PATHOS_HOME_TIMEZONE="America/Los_Angeles" # Pathos's simulated home timezone

# Intervals for background processes (seconds)
ETHOS_REFLECTION_INTERVAL_SECONDS=86400 # Daily reflection
ETHOS_FORGETTING_INTERVAL_SECONDS=43200 # Twice a day
ETHOS_HEXUS_DECAY_INTERVAL_SECONDS=3600 # Hourly
ETHOS_KNOWLEDGE_UPKEEP_INTERVAL_SECONDS=86400 # Daily
ETHOS_INTERACTION_LOG_ANALYSIS_INTERVAL_SECONDS=86400 # Daily
ETHOS_LONG_TERM_PLANNING_INTERVAL_SECONDS=259200 # Every 3 days
ETHOS_PROACTIVE_CHECK_INTERVAL_SECONDS=120 # Check for proactive opportunities every 2 mins
ETHOS_CHRONOS_MAINTENANCE_INTERVAL_SECONDS=21600 # Every 6 hours

# Salience, Mood, Hexus Parameters
ETHOS_SALIENCE_DECAY_RATE_PER_DAY=0.01
ETHOS_MIN_SALIENCE_FOR_DECAY=0.01
ETHOS_USER_FACT_SALIENCE_FLOOR=1.0 # Facts about the user (friend) are important
ETHOS_MOOD_DECAY_RATE_PER_HOUR=0.05
ETHOS_FEEDBACK_SALIENCE_BOOST=0.3 # Feedback still matters, but less directly controlling
ETHOS_HEXUS_DECAY_RATE_PER_CYCLE=0.005
ETHOS_HEXUS_ACTIVATION_THRESHOLD=0.1
ETHOS_HEXUS_CURVE_K=2.0
ETHOS_HEXUS_FEEDBACK_ADJUSTMENT_STEP=0.02 # Reduced impact

# Text Processing
ETHOS_TEXT_CHUNK_SIZE=1000
ETHOS_TEXT_CHUNK_OVERLAP=150

# Proactive Behavior Parameters
ETHOS_PROACTIVE_GREETING_INTERVAL_HOURS=6
ETHOS_PROACTIVE_TOPIC_INTERVAL_HOURS=18
ETHOS_PROACTIVE_ENGAGEMENT_THRESHOLD=0.1
ETHOS_PROACTIVE_ENGAGEMENT_CURVE_K=2.5
ETHOS_PROACTIVE_QUEUED_POINT_OFFER_INTERVAL_HOURS=12 # If Pathos had a thought to share
ETHOS_PROACTIVE_GREETING_CHANCE=0.4
ETHOS_PROACTIVE_TOPIC_CHANCE=0.25
ETHOS_PROACTIVE_BRIEFING_CHANCE=0.1 # Pathos might mention something from his "briefing" if relevant
ETHOS_PROACTIVE_QUEUED_POINT_CHANCE=0.6
ETHOS_PROACTIVE_IMMEDIATE_GREETING_GRACE_MINUTES=10 # If user appears after Pathos was busy
ETHOS_PROACTIVE_IMMEDIATE_GREETING_CHANCE=0.8

# LLM Roles for Ethos Tasks
ETHOS_SUMMARIZATION_LLM_ROLE="LOGOS_TECHNE"
ETHOS_INTERACTION_LOG_ANALYSIS_LLM_ROLE="LOGOS_TECHNE"
ETHOS_KNOWLEDGE_UPKEEP_LLM_ROLE="LOGOS_TECHNE"
ETHOS_ASPIRATION_LLM_ROLE="LOGOS_TECHNE" # For generating/refining Pathos's goals
ETHOS_LONG_TERM_PLANNING_LLM_ROLE="LOGOS_TECHNE" # For Pathos planning his aspirations
ETHOS_SCHEDULER_LLM_ROLE="LOGOS_TECHNE" # For Chronos generating daily activities
ETHOS_REFLECTION_FEEDBACK_LLM_ROLE="LOGOS_TECHNE" # For Pathos reflecting on feedback
ETHOS_DREAM_CURIOSITY_LLM_ROLE="LOGOS_TECHNE" # For Pathos getting curious from dreams
ETHOS_CURIOSITY_NOTIFICATION_LLM_ROLE="LOGOS_TECHNE" # For Pathos phrasing his new knowledge

# Memory & Learning Parameters
ETHOS_ENABLE_MEMORY_SUMMARIZATION=True
ETHOS_SUMMARIZATION_CLUSTER_MIN_MEMORIES=5
ETHOS_SUMMARIZATION_MAX_MEMORIES_PER_CLUSTER=15
ETHOS_SUMMARIZATION_MAX_TEXT_LENGTH_FOR_PROMPT=10000
ETHOS_SUMMARIZATION_MAX_DAYS_TO_CONSIDER=30
ETHOS_KNOWLEDGE_UPKEEP_VOLATILE_TAGS='["current events", "public figures", "technology trends"]'
ETHOS_ENABLE_INTERACTION_LOG_ANALYSIS=True
ETHOS_INTERACTION_LOG_ANALYSIS_BATCH_SIZE=20
ETHOS_INTERACTION_LOG_ANALYSIS_MAX_DAYS_LOOKBACK=7
ETHOS_ASPIRATION_NUM_SEED_MEMORIES=5
ETHOS_ASPIRATION_MIN_SALIENCE_SEED=0.5
ETHOS_LONG_TERM_PLANNING_MAX_ASPIRATIONS=3 # How many goals Pathos actively works on
ETHOS_LONG_TERM_PLANNING_RESEARCH_DEPTH=2 # How many searches for planning
ETHOS_CURIOSITY_RESEARCH_ON_LEARNINGS_LIMIT=2
ETHOS_CURIOSITY_RESEARCH_ON_LEARNINGS_INTERVAL_HOURS=24

# -----------------------------------------------------------------------------
# Oneiros Module Configuration (Pathos's Dreams)
# -----------------------------------------------------------------------------
ONEIROS_DREAM_INTERVAL_SECONDS=28800 # Every 8 hours (e.g., during simulated sleep)
ONEIROS_WILDCARD_FILES_DIR=./wildcards
ONEIROS_STABLE_DIFFUSION_URL=http://your_stable_diffusion_server_ip:7860 # Optional
ONEIROS_DREAM_LLM_ROLE="LOGOS_TECHNE" # Or a more creative, smaller LLM
ONEIROS_DREAM_NUM_SOURCE_MEMORIES=4
ONEIROS_DREAM_MIN_SALIENCE_FOR_SOURCE=0.2
ONEIROS_ENABLE_IMAGE_DREAMS=False # Set to True if Stable Diffusion is configured
ONEIROS_IMAGE_OUTPUT_DIR=./eidos_dream_images
ONEIROS_DREAM_LLM_TEMPERATURE=1.2
ONEIROS_DREAM_LLM_TOP_P=0.9
ONEIROS_DREAM_LLM_PRESENCE_PENALTY=0.5
ONEIROS_DREAM_LLM_FREQUENCY_PENALTY=0.3
ONEIROS_DREAM_LLM_MAX_TOKENS=1024

# -----------------------------------------------------------------------------
# API Server Configuration - REQUIRED
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8088
API_LOG_LEVEL=debug # Set to 'info' for less verbose logging

# -----------------------------------------------------------------------------
# External Services (Used by Pathos via "Computer Interaction Module" or by Firmament)
# -----------------------------------------------------------------------------

# OpenWeatherMap (Pathos might check weather for his plans)
OWM_API_KEY=YOUR_OWM_API_KEY
OWM_UNITS=imperial
OWM_BASE_URL=https://api.openweathermap.org
OWM_TIMEOUT=10

# Wolfram Alpha (Pathos might use for complex queries/calculations for himself)
# ENABLE_WOLFRAM_ALPHA=True # This flag is in code, ensure it's True if using
WOLFRAM_ALPHA_APP_ID=YOUR_WOLFRAM_ALPHA_APP_ID
WOLFRAM_ALPHA_API_URL=http://api.wolframalpha.com/v2/query
WOLFRAM_ALPHA_TIMEOUT=25

# News API (thenewsapi.com - Pathos might read news)
# NEWS_API_ENABLED=True # This flag is in code, ensure it's True if using
NEWS_API_KEY=YOUR_THENEWSAPI_KEY
NEWS_API_BASE_URL=https://api.thenewsapi.com
NEWS_API_DEFAULT_LOCALE=us
NEWS_API_DEFAULT_LANGUAGE=en
NEWS_API_LIMIT=3 # Pathos probably reads just a few headlines
NEWS_API_TIMEOUT=20

# Brave Search (For Pathos's "computer" web searches) - REQUIRED for web search
BRAVE_API_KEY=YOUR_BRAVE_SEARCH_API_KEY
BRAVE_SEARCH_TIMEOUT=15
BRAVE_SEARCH_MAX_RESULTS=3 # Pathos skims a few results

# -----------------------------------------------------------------------------
# Kokoro TTS Service (External TTS Provider) - Optional
# -----------------------------------------------------------------------------
KOKORO_TTS_API_URL="http://your_kokoro_tts_server_ip:8880/v1/audio/speech"
KOKORO_TTS_MODEL_ID="kokoro" # Or other model if your Kokoro instance supports it
KOKORO_TTS_VOICE_ID="your_chosen_kokoro_voice_id" # e.g., bm_george, af_heart
KOKORO_TTS_RESPONSE_FORMAT="mp3" # wav, opus, etc.
KOKORO_TTS_SPEED="1.0" # 0.25 to 4.0
KOKORO_TTS_TIMEOUT="60"
KOKORO_TTS_LANG_CODE="en-US"
# KOKORO_TTS_API_KEY= # If your Kokoro instance requires an API key
# KOKORO_TTS_NORMALIZATION_OPTIONS='{"normalize": true, "phone_normalization": false}' # Optional JSON string

# -----------------------------------------------------------------------------
# System Behavior & Security
# -----------------------------------------------------------------------------
MAX_CONCURRENT_TASKS=10 # Max parallel background tasks in EthosCore
EIDOS_ADMIN_PASSWORD=your_secure_admin_password_here # For privileged API actions

