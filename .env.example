# .env.example - Eidos Configuration Template
# Copy this file to .env and fill in your actual values for your local setup.
# DO NOT COMMIT YOUR ACTUAL .env FILE WITH REAL SECRETS.

# --- LLM Configurations ---
# Pathos (LLM #2 - Conversation & Tool Use) - REQUIRED
LLM_PATHOS_URL=http://localhost:1234/v1 # Example: Use your LM Studio or Ollama URL
LLM_PATHOS_MODEL= # e.g., llama-3-8b-instruct, or leave blank if your provider handles it
LLM_PATHOS_TEMP=0.4
LLM_PATHOS_TIMEOUT=300
LLM_PATHOS_API_KEY=lm-studio # Options: lm-studio, ollama, or your_actual_api_key for cloud services
LLM_PATHOS_MAX_TOKENS=4096
LLM_PATHOS_MAX_TOOL_ITERATIONS=3
# LLM_PATHOS_TOP_P=0.95
# LLM_PATHOS_PRESENCE_PENALTY=0.0
# LLM_PATHOS_FREQUENCY_PENALTY=0.0

# Logos Techne (LLM #3 - Summarization, Reflection, Knowledge Upkeep) - REQUIRED
LLM_LOGOS_TECHNE_URL=http://localhost:1234/v1
LLM_LOGOS_TECHNE_MODEL= # e.g., your_summarization_model_name
LLM_LOGOS_TECHNE_TEMP=0.2
LLM_LOGOS_TECHNE_TIMEOUT=300
LLM_LOGOS_TECHNE_API_KEY=lm-studio
LLM_LOGOS_TECHNE_MAX_TOKENS=2048
# LLM_LOGOS_TECHNE_TOP_P=0.95
# LLM_LOGOS_TECHNE_PRESENCE_PENALTY=0.0
# LLM_LOGOS_TECHNE_FREQUENCY_PENALTY=0.0

# Logos Vision/Context (LLM #1) - REQUIRED if ENABLE_VISION_PROCESSING=True
LLM_LOGOS_VISION_URL=http://localhost:1234/v1 # Or your vision model provider URL
LLM_LOGOS_VISION_MODEL= # e.g., llava, gemma-3-12b-it-qat
LLM_LOGOS_VISION_API_KEY=lm-studio
LLM_LOGOS_VISION_TEMP=0.2
LLM_LOGOS_VISION_TIMEOUT=60
LLM_LOGOS_VISION_MAX_TOKENS=1024
# LLM_LOGOS_VISION_TOP_P=0.95
# LLM_LOGOS_VISION_PRESENCE_PENALTY=0.0
# LLM_LOGOS_VISION_FREQUENCY_PENALTY=0.0

# Logos Deep Research (LLM #4) - REQUIRED if perform_deep_research tool is used
LLM_LOGOS_RESEARCH_URL=http://localhost:1234/v1
LLM_LOGOS_RESEARCH_MODEL= # e.g., your_research_model_name
LLM_LOGOS_RESEARCH_TEMP=0.5
LLM_LOGOS_RESEARCH_TIMEOUT=180
LLM_LOGOS_RESEARCH_API_KEY=lm-studio
LLM_LOGOS_RESEARCH_MAX_TOKENS=4096
# LLM_LOGOS_RESEARCH_TOP_P=0.95
# LLM_LOGOS_RESEARCH_PRESENCE_PENALTY=0.0
# LLM_LOGOS_RESEARCH_FREQUENCY_PENALTY=0.0

# --- Feature Flags ---
ENABLE_AISTHESIS=False
ENABLE_AMBIENT_AUDIO=False
ENABLE_VISION_PROCESSING=True
ENABLE_DAILY_CONTEXT=True
ENABLE_ONEIROS=True
ENABLE_PROACTIVE_BEHAVIOR=True
ENABLE_MOOD_SIMULATION=True
ENABLE_MANAGED_FORGETTING=True
ENABLE_LEARNING_FROM_FEEDBACK=True
ENABLE_CURIOUSITY=True
ENABLE_WOLFRAM_ALPHA=True
ENABLE_WEB_SEARCH=True
ENABLE_KNOWLEDGE_UPKEEP=True
NEWS_API_ENABLED=True

# --- Home Assistant Configuration --- (Optional)
# HA_URL=http://your_ha_ip_or_hostname:8123
# HA_TOKEN=YOUR_LONG_LIVED_ACCESS_TOKEN
# HA_ALLOWED_DOMAINS='["light", "switch", "climate", "media_player", "automation", "sensor", "binary_sensor", "timer", "persistent_notification", "scene", "lock", "fan", "weather"]'
# HA_TIMEOUT=15
# HA_WEATHER_ENTITY_ID=weather.your_weather_entity

# --- Voice Interface Configuration ---
# VOICE_ENERGY_THRESHOLD=300
# VOICE_DEFAULT_VOICE=female
# VOICE_WAKE_WORD=eidos
# VOICE_STT_MODEL=

# --- Ethos Core Configuration --- REQUIRED ---
ETHOS_EMBEDDING_MODEL=all-MiniLM-L6-v2
ETHOS_MEMORY_DB_PATH=./eidos_memories/memory.sqlite
ETHOS_SALIENCE_DECAY_RATE_PER_DAY=0.01
ETHOS_MIN_SALIENCE_FOR_DECAY=0.01
ETHOS_REFLECTION_INTERVAL_SECONDS=86400
ETHOS_FORGETTING_INTERVAL_SECONDS=43200
ETHOS_MOOD_DECAY_RATE_PER_HOUR=0.05
ETHOS_FEEDBACK_SALIENCE_BOOST=0.5
ETHOS_TEXT_CHUNK_SIZE=1000
ETHOS_TEXT_CHUNK_OVERLAP=150
ETHOS_EMBEDDING_MAX_TEXT_LENGTH=2560
ETHOS_HEXUS_DECAY_INTERVAL_SECONDS=3600
ETHOS_HEXUS_DECAY_RATE_PER_CYCLE=0.005
ETHOS_HEXUS_ACTIVATION_THRESHOLD=0.1
ETHOS_HEXUS_CURVE_K=2.0
ETHOS_USER_FACT_SALIENCE_FLOOR=1.0
ETHOS_PROACTIVE_GREETING_INTERVAL_HOURS=4
ETHOS_PROACTIVE_TOPIC_INTERVAL_HOURS=12
ETHOS_PROACTIVE_ENGAGEMENT_THRESHOLD=0.1
ETHOS_PROACTIVE_ENGAGEMENT_CURVE_K=2.5
ETHOS_PROACTIVE_CHECK_INTERVAL_SECONDS=60
ETHOS_PROACTIVE_QUEUED_POINT_OFFER_INTERVAL_HOURS=24
ETHOS_ENABLE_MEMORY_SUMMARIZATION=True
ETHOS_SUMMARIZATION_LLM_ROLE=LOGOS_TECHNE
ETHOS_SUMMARIZATION_CLUSTER_MIN_MEMORIES=5
ETHOS_SUMMARIZATION_MAX_MEMORIES_PER_CLUSTER=15
ETHOS_SUMMARIZATION_MAX_TEXT_LENGTH_FOR_PROMPT=10000
ETHOS_SUMMARIZATION_MAX_DAYS_TO_CONSIDER=30
ETHOS_KNOWLEDGE_UPKEEP_INTERVAL_SECONDS=86400
ETHOS_KNOWLEDGE_UPKEEP_LLM_ROLE=LOGOS_TECHNE
ETHOS_KNOWLEDGE_UPKEEP_VOLATILE_TAGS='["current events", "statistics", "rankings", "records", "technology", "world leaders", "company information", "scientific discoveries", "product releases"]'

# --- Oneiros Module Configuration ---
ONEIROS_DREAM_INTERVAL_SECONDS=21600
ONEIROS_WILDCARD_FILES_DIR=./wildcards
ONEIROS_STABLE_DIFFUSION_URL=http://localhost:7860 # Example for local Stable Diffusion/Forge
ONEIROS_DREAM_LLM_ROLE=PATHOS
ONEIROS_DREAM_NUM_SOURCE_MEMORIES=3
ONEIROS_DREAM_MIN_SALIENCE_FOR_SOURCE=0.0
ONEIROS_ENABLE_IMAGE_DREAMS=True
ONEIROS_IMAGE_OUTPUT_DIR=./eidos_dream_images
ONEIROS_DREAM_LLM_TEMPERATURE=1.3
ONEIROS_DREAM_LLM_TOP_P=0.95
ONEIROS_DREAM_LLM_PRESENCE_PENALTY=0.8
ONEIROS_DREAM_LLM_FREQUENCY_PENALTY=0.2
ONEIROS_DREAM_LLM_MAX_TOKENS=2048

# --- Aisthesis Network Configuration ---
# AISTHESIS_MQTT_BROKER_URL=
# AISTHESIS_MQTT_BROKER_PORT=1883
# AISTHESIS_MQTT_TOPIC_PREFIX=eidos/sensor/
# AISTHESIS_NODES_JSON={}

# --- API Server Configuration --- REQUIRED ---
API_HOST=0.0.0.0
API_PORT=8088
API_LOG_LEVEL=debug

# --- OpenWeatherMap Configuration --- REQUIRED if get_weather tool is used without HA/Wolfram fallback
OWM_API_KEY=YOUR_OPENWEATHERMAP_API_KEY_HERE # Replace with your actual key locally
OWM_UNITS=imperial
OWM_BASE_URL=https://api.openweathermap.org
OWM_TIMEOUT=10

# --- Wolfram Alpha Configuration --- REQUIRED if ENABLE_WOLFRAM_ALPHA=True ---
WOLFRAM_ALPHA_APP_ID=YOUR_WOLFRAM_ALPHA_APP_ID_HERE # Replace with your actual key locally
WOLFRAM_ALPHA_API_URL=http://api.wolframalpha.com/v2/query
WOLFRAM_ALPHA_TIMEOUT=25

# --- News API Configuration (TheNewsAPI.com) --- REQUIRED if NEWS_API_ENABLED=True ---
NEWS_API_KEY=YOUR_NEWS_API_KEY_HERE # Replace with your actual key locally
NEWS_API_BASE_URL=https://api.thenewsapi.com
NEWS_API_DEFAULT_LOCALE=us
NEWS_API_DEFAULT_LANGUAGE=en
NEWS_API_LIMIT=5
NEWS_API_TIMEOUT=20
# NEWS_API_SEARCH_KEYWORDS=
# NEWS_API_CATEGORIES=general,tech
# NEWS_API_INCLUDE_SOURCE_IDS=
# NEWS_API_EXCLUDE_SOURCE_IDS=

# --- Brave Search Configuration --- REQUIRED if ENABLE_WEB_SEARCH=True ---
BRAVE_API_KEY=YOUR_BRAVE_SEARCH_API_KEY_HERE # Replace with your actual key locally
BRAVE_SEARCH_TIMEOUT=15
BRAVE_SEARCH_MAX_RESULTS=3

# --- System Behavior ---
MAX_CONCURRENT_TASKS=5
# --- System Behavior ---
MAX_CONCURRENT_TASKS=5
SPARK_TTS_API_URL=http://
EIDOS_TTS_DEFAULT_GENDER=male
EIDOS_TTS_DEFAULT_PITCH_STR=moderate  # e.g., very_low, low, moderate, high, very_high
EIDOS_TTS_DEFAULT_SPEED_STR=moderate  # e.g., very_low, low, moderate, high, very_high

# --- Security ---
EIDOS_ADMIN_PASSWORD= # Leave blank or set a strong password for your local instance